# Template .env untuk server production.
# deploy/setup-server.sh menyalin file ini menjadi .env dan mengisi
# APP_URL, APP_KEY, serta DB_PASSWORD secara otomatis.

APP_NAME="MTQ Kota Malang 2026"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://__APP_HOST__
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mtq_kota_malang
DB_USERNAME=mtq
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Diubah menjadi true oleh deploy/enable-https.sh setelah SSL aktif.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Aplikasi tidak memakai antrean (queue), jadi tidak perlu worker.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Akun admin awal untuk `php artisan db:seed` (minimal 12 karakter).
MTQ_ADMIN_NAME="Admin MTQ 2026"
MTQ_ADMIN_EMAIL=
MTQ_ADMIN_PASSWORD=
